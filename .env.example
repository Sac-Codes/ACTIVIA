# ACTIVIA — Environment Variables
# Copy this to .env and fill in your actual Firebase values

# ── Server Configuration ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Database Path (defaults to ./data/campusflow.sqlite)
DATABASE_PATH=./data/campusflow.sqlite

# Session Secret (change in production deployment)
SESSION_SECRET=campusflow_competition_super_secret_jwt_key_2026_secured!

# ── Firebase Configuration (Client-Side, Vite exposed via VITE_ prefix) ────────
# Get these values from Firebase Console → Project Settings → Your Apps → Web App
# https://console.firebase.google.com/project/activia-f36ee/settings/general

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=activia-f36ee.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=activia-f36ee
VITE_FIREBASE_STORAGE_BUCKET=activia-f36ee.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ── Firebase Emulator (set to 'true' to use local emulators) ──────────────────
VITE_USE_FIREBASE_EMULATOR=false

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Set to 'firebase' to use Firebase Auth/Firestore, 'express' for Express+SQLite
VITE_AUTH_MODE=firebase
