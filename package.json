{
  "name": "campusflow-dashboard",
  "version": "1.0.0",
  "description": "CampusFlow - Smart School Activity Coordination Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "tsx server/seed.ts",
